<Application x:Class="MediaScribeRecorder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#14213D"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5D6474"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9DEE8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1B7F79"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
  </Application.Resources>
</Application>
